{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/landing", "permanent": false },
    { "source": "/app", "destination": "/landing", "permanent": false },
    { "source": "/meta", "destination": "/landing", "permanent": false },
    { "source": "/upload", "destination": "/landing", "permanent": false },
    { "source": "/viewer", "destination": "/landing", "permanent": false },
    { "source": "/share/:path*", "destination": "/landing", "permanent": false }
  ],
  "rewrites": [
    { "source": "/result/:token",      "destination": "/result_card?token=:token" },
    { "source": "/club/:token",        "destination": "/club_public?token=:token" },
    { "source": "/tutorial/personal", "destination": "/tutorial_personal" },
    { "source": "/tutorial/record",   "destination": "/tutorial_record" },
    { "source": "/tutorial/data",     "destination": "/tutorial_data" },
    { "source": "/tutorial/coach",    "destination": "/tutorial_coach" },
    { "source": "/tutorial/help",     "destination": "/tutorial_help" },
    { "source": "/api/:path*",       "destination": "https://swimtech-api.onrender.com/api/:path*" },
    { "source": "/auth/:path*",      "destination": "https://swimtech-api.onrender.com/auth/:path*" },

    { "source": "/pool",             "destination": "https://swimtech-api.onrender.com/pool" },

    { "source": "/share/:path*",     "destination": "/share" },
    { "source": "/badges",           "destination": "/badge" },
    { "source": "/training-log",     "destination": "/training_log" }
  ]
}
